# iMenu25 vendor console. Everything here is OPTIONAL on a dev machine:
# without a console/.env the console reuses the MySQL login from backend/.env and starts with owner / change-me-now.

CONSOLE_PORT=4000
CONSOLE_DB_NAME=imenu_console      # created automatically

# MySQL login (default: taken from backend/.env)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password_here

# The one login for the panel. Change both before hosting it anywhere!
CONSOLE_ADMIN_USER=owner
CONSOLE_ADMIN_PASSWORD=change-me-now
CONSOLE_JWT_SECRET=long-random-string

# What a never-seen device gets: allowed (default) or pending (blocked until you approve it)
CONSOLE_NEW_DEVICE_STATUS=allowed

# Created on the very first start if there are no customers yet (code = what a device uses to join it)
CONSOLE_FIRST_CUSTOMER=My first customer
CONSOLE_FIRST_CODE=FIRST
