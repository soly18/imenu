# iMenu25 vendor console (run it on YOUR server, not at the customer)
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=imenu_console          # created automatically

# The one login for the panel. Change both!
CONSOLE_ADMIN_USER=owner
CONSOLE_ADMIN_PASSWORD=change-me-now
CONSOLE_JWT_SECRET=long-random-string

# What a never-seen device gets: allowed (default) or pending (blocked until you approve it)
CONSOLE_NEW_DEVICE_STATUS=allowed
